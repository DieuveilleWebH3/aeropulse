# AeroPulse application settings.
# Copy this file to .env for local development. Never commit real secrets.

AEROPULSE_APP_NAME=AeroPulse
AEROPULSE_ENVIRONMENT=local
AEROPULSE_DEBUG=false

# Application dependency URLs.
AEROPULSE_DATABASE_URL=postgresql+asyncpg://aeropulse:aeropulse_dev@127.0.0.1:5432/aeropulse
AEROPULSE_REDIS_URL=redis://127.0.0.1:6379/0
AEROPULSE_DEPENDENCY_TIMEOUT_SECONDS=1.0

# Docker Compose development values.
AEROPULSE_POSTGRES_DB=aeropulse
AEROPULSE_POSTGRES_USER=aeropulse
AEROPULSE_POSTGRES_PASSWORD=aeropulse_dev
AEROPULSE_POSTGRES_PORT=5432
AEROPULSE_REDIS_PORT=6379
